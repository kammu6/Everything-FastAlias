<Application x:Class="EverythingFastAlias.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EverythingFastAlias"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:conv="clr-namespace:EverythingFastAlias.Converters"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemeResources />
                <ui:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Slate-50 기반 클린 라이트 테마 브러시 재정의 -->
            <SolidColorBrush x:Key="SystemControlPageBackgroundChromeLowBrush" Color="#F8FAFC"/>
            <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SystemControlElevationBorderBrush" Color="#E2E8F0"/>

            <!-- Bool → Visibility 전역 컨버터 -->
            <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
            <conv:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
