<Window x:Class="EverythingFastAlias.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:modern="http://schemas.modernwpf.com/2019"
        xmlns:views="clr-namespace:EverythingFastAlias.Views"
        xmlns:vm="clr-namespace:EverythingFastAlias.ViewModels"
        Title="Everything FastAlias" 
        Height="850" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
        modern:ThemeManager.RequestedTheme="Light"
        Loaded="Window_Loaded">

    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 1. 메뉴바 & 상단 헤더 -->
            <RowDefinition Height="Auto"/> <!-- 2. 검색 컨트롤 그룹 -->
            <RowDefinition Height="*"/>    <!-- 3. 메인 스플릿 바디 -->
            <RowDefinition Height="Auto"/> <!-- 4. 상태 표시 바 -->
        </Grid.RowDefinitions>

        <!-- 1. 인라인 Slim 메뉴바 -->
        <Menu Grid.Row="0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" Padding="5,2,5,2"
              BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="0,0,0,1">
            <MenuItem Header="파일(F)">
                <MenuItem Header="종료(X)" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="도구(T)">
                <MenuItem Header="매핑 테이블 관리자 (Alias Manager)" Command="{Binding OpenAliasManagerCommand}"/>
            </MenuItem>
            <MenuItem Header="도움말(H)">
                <MenuItem Header="도움말 보기 (F1)" Command="{Binding OpenHelpCommand}"/>
            </MenuItem>
        </Menu>

        <!-- 2. 검색 입력 및 스위치 영역 -->
        <Border Grid.Row="1" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" 
                Padding="15,10,15,10" BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="0,0,0,1">
            <modern:SimpleStackPanel Spacing="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- FastAlias On/Off 스위치 -->
                        <ColumnDefinition Width="*"/>    <!-- 검색 인풋 박스 -->
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                        <TextBlock Text="FastAlias" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,0"/>
                        <modern:ToggleSwitch IsOn="{Binding SearchVM.Options.UseFastAlias}" 
                                             OnContent="ON" OffContent="OFF" 
                                             Style="{StaticResource CardToggleSwitchStyle}"
                                             Toggled="FastAliasSwitch_Toggled"/>
                    </StackPanel>

                    <!-- 검색창 인풋 -->
                    <Grid Grid.Column="1">
                        <TextBox FontSize="15" Padding="8,5,30,5" 
                                 modern:ControlHelper.PlaceholderText="검색할 파일 또는 폴더명을 입력하세요... (예: 사과 | banana)" 
                                 Text="{Binding SearchVM.SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxStyle}"/>
                        
                        <!-- 전체 지우기 [X] 버튼 -->
                        <Button Content="✕" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Center" 
                                Margin="0,0,8,0" Style="{StaticResource ButtonStyle}" Click="ClearSearch_Click" 
                                Background="Transparent" BorderThickness="0" Foreground="Gray" FontSize="11"/>
                    </Grid>
                </Grid>

                <!-- 제외단어 및 폴더경로 제한 세부 인풋 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" modern:ControlHelper.PlaceholderText="최종 쿼리에서 제외할 단어 입력... (예: tmp;temp)" 
                             Text="{Binding SearchVM.ExcludedWords, UpdateSourceTrigger=PropertyChanged}"/>
                    
                    <TextBox Grid.Column="2" modern:ControlHelper.PlaceholderText="검색할 직계 경로 지정... (예: C:\Folder1;D:\Folder2)" 
                             Text="{Binding SearchVM.FolderPaths, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </modern:SimpleStackPanel>
        </Border>

        <!-- 3. 메인 스플릿 바디 (30% : 70% 리사이징) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="320"/> <!-- 30% 좌측 사이드바 -->
                <ColumnDefinition Width="Auto"/>               <!-- 리사이저 드래그 핸들 -->
                <ColumnDefinition Width="*"/>                  <!-- 70% 우측 데이터 그리드 -->
            </Grid.ColumnDefinitions>

            <!-- 좌측 컨트롤러 사이드바 -->
            <views:LeftSidebarView Grid.Column="0" DataContext="{Binding SearchVM}"
                                   BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="0,0,1,0"/>

            <!-- 3:7 스플릿 리사이저 핸들 -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{DynamicResource SystemControlElevationBorderBrush}"/>

            <!-- 우측 데이터 가상화 리스트뷰 -->
            <views:ResultGridView Grid.Column="2" DataContext="{Binding SearchVM}"/>
        </Grid>

        <!-- 4. 상태 표시 바 (StatusBar) -->
        <StatusBar Grid.Row="3" Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                   BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="0,1,0,0" Padding="10,5,10,5">
            <Grid Width="{Binding RelativeSource={RelativeSource AncestorType=StatusBar}, Path=ActualWidth}" Margin="0,0,20,0">
                <TextBlock Text="{Binding SearchVM.StatusMessage}" FontSize="12" Foreground="DimGray" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding SearchVM.ResultCountMessage}" FontSize="12" Foreground="DimGray" HorizontalAlignment="Right" Margin="0,0,10,0"/>
            </Grid>
        </StatusBar>
    </Grid>
</Window>
