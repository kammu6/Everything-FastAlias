<Window x:Class="EverythingFastAlias.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:modern="http://schemas.modernwpf.com/2019"
        xmlns:views="clr-namespace:EverythingFastAlias.Views"
        xmlns:vm="clr-namespace:EverythingFastAlias.ViewModels"
        Title="Everything FastAlias" 
        Height="850" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
        modern:ThemeManager.RequestedTheme="Light"
        Closing="Window_Closing"
        Loaded="Window_Loaded"
        Icon="/Assets/app_icon.ico">

    <Window.Resources>
        <!-- 글씨 크기 스타일 일괄 적용 정의 -->
        <Style TargetType="Menu">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/>
        </Style>
        <Style TargetType="StatusBar">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 1. 메뉴바 & 상단 헤더 -->
            <RowDefinition Height="Auto"/> <!-- 2. 검색 컨트롤 그룹 -->
            <RowDefinition Height="*"/>    <!-- 3. 메인 스플릿 바디 -->
            <RowDefinition Height="Auto"/> <!-- 4. 상태 표시 바 -->
        </Grid.RowDefinitions>

        <!-- 1. 인라인 Slim 메뉴바 -->
        <Menu Grid.Row="0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" Padding="5,2,5,2"
              BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="0,0,0,1">
            <MenuItem Header="파일(F)">
                <MenuItem Header="새창 띄우기(N)" Command="{Binding NewWindowCommand}"/>
                <MenuItem Header="결과 내보내기(E)..." Command="{Binding ExportResultsCommand}"/>
                <Separator/>
                <MenuItem Header="시작프로그램 등록" IsCheckable="True" IsChecked="{Binding IsAutoStartEnabled}"/>
                <MenuItem Header="시스템 트레이 최소화 사용" IsCheckable="True" IsChecked="{Binding IsMinimizeToTrayEnabled}"/>
                <Separator/>
                <MenuItem Header="종료(X)" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="도구(T)">
                <MenuItem Header="매핑 테이블 관리자 (Alias Manager)" Command="{Binding OpenAliasManagerCommand}"/>
            </MenuItem>
            <MenuItem Header="도움말(H)">
                <MenuItem Header="도움말 보기 (F1)" Command="{Binding OpenHelpCommand}"/>
            </MenuItem>
        </Menu>

        <!-- 2. 검색 입력 및 스위치 영역 -->
        <Border Grid.Row="1" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                Padding="12,8,12,8" BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- 1. 토글+새로고침 영역 -->
                    <ColumnDefinition Width="Auto"/> <!-- 2. 세로 구분선 -->
                    <ColumnDefinition Width="*"/>    <!-- 3. 라벨+검색 입력 영역 -->
                </Grid.ColumnDefinitions>

                <!-- Column 0: 3행 토글+새로고침 영역 -->
                <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: FastAlias 토글 -->
                    <Grid Grid.Row="0" MinWidth="175">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="FastAlias 별칭" VerticalAlignment="Center"
                                   FontWeight="SemiBold" FontSize="12" Margin="0,0,6,0"/>
                        <modern:ToggleSwitch Grid.Column="1" IsOn="{Binding SearchVM.Options.UseFastAlias}"
                                             OnContent="ON" OffContent="OFF"
                                             Toggled="FastAliasSwitch_Toggled"/>
                    </Grid>

                    <!-- Row 2: 옵션패널 토글 -->
                    <Grid Grid.Row="2" MinWidth="175">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="옵션패널 표시" VerticalAlignment="Center"
                                   FontWeight="SemiBold" FontSize="12" Margin="0,0,6,0"/>
                        <modern:ToggleSwitch Grid.Column="1" x:Name="SidebarToggleSwitch" IsOn="True"
                                             OnContent="ON" OffContent="OFF"
                                             Toggled="SidebarToggleSwitch_Toggled"/>
                    </Grid>

                    <!-- Row 4: 새로고침 버튼 -->
                    <Button Grid.Row="4"
                            Content="🔄  새로고침"
                            Command="{Binding SearchVM.RefreshCommand}"
                            HorizontalAlignment="Stretch"
                            Height="30"
                            FontSize="12"/>
                </Grid>

                <!-- Column 1: 세로 구분선 -->
                <Border Grid.Column="1" Width="1"
                        Background="{DynamicResource SystemControlElevationBorderBrush}"
                        Margin="12,0,14,0" VerticalAlignment="Stretch"/>

                <!-- Column 2: 라벨 + 3행 대칭 검색 입력 영역 -->
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/> <!-- 라벨 고정 폭 -->
                        <ColumnDefinition Width="*"/> <!-- 입력란 -->
                    </Grid.ColumnDefinitions>

                    <!-- Row 0: 검색단어 -->
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="검색단어" FontWeight="SemiBold" FontSize="11"
                               VerticalAlignment="Center" Foreground="DimGray" Margin="0,0,6,0"/>
                    <Grid Grid.Row="0" Grid.Column="1">
                        <TextBox FontSize="12" Padding="8,5,65,5"
                                 modern:ControlHelper.PlaceholderText="파일/폴더명 (예: 사과 | apple)"
                                 Text="{Binding SearchVM.SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                            <TextBlock Text="💡" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0" Cursor="Help">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchVM.Options.UseFastAlias}" Value="True">
                                                <Setter Property="Opacity" Value="1.0"/>
                                                <Setter Property="ToolTip" Value="FastAlias 매핑 활성화됨 (ON)"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SearchVM.Options.UseFastAlias}" Value="False">
                                                <Setter Property="Opacity" Value="0.2"/>
                                                <Setter Property="ToolTip" Value="FastAlias 매핑 비활성화됨 (OFF)"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Content="✕" Width="18" Height="18" Click="ClearSearch_Click"
                                    Background="Transparent" BorderThickness="0" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 2: 제외단어 -->
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="제외단어" FontWeight="SemiBold" FontSize="11"
                               VerticalAlignment="Center" Foreground="DimGray" Margin="0,0,6,0"/>
                    <TextBox Grid.Row="2" Grid.Column="1" FontSize="12" Padding="8,5,8,5"
                             modern:ControlHelper.PlaceholderText="제외할 단어 (예: tmp;temp)"
                             Text="{Binding SearchVM.ExcludedWords, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Row 4: 지정경로 -->
                    <TextBlock Grid.Row="4" Grid.Column="0"
                               Text="지정경로" FontWeight="SemiBold" FontSize="11"
                               VerticalAlignment="Center" Foreground="DimGray" Margin="0,0,6,0"/>
                    <TextBox Grid.Row="4" Grid.Column="1" FontSize="12" Padding="8,5,8,5"
                             modern:ControlHelper.PlaceholderText="검색 경로 지정 (예: C:\Folder1;D:\Folder2)"
                             Text="{Binding SearchVM.FolderPaths, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 3. 메인 스플릿 바디 (30% : 70% 리사이징) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="320" MinWidth="320"/> <!-- 30% 좌측 사이드바 -->
                <ColumnDefinition Width="Auto"/>               <!-- 리사이저 드래그 핸들 -->
                <ColumnDefinition Width="*"/>                  <!-- 70% 우측 데이터 그리드 -->
            </Grid.ColumnDefinitions>

            <!-- 좌측 컨트롤러 사이드바 -->
            <views:LeftSidebarView x:Name="SidebarView" Grid.Column="0" DataContext="{Binding SearchVM}"
                                   BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="0,0,1,0"/>

            <!-- 3:7 스플릿 리사이저 핸들 -->
            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{DynamicResource SystemControlElevationBorderBrush}"/>

            <!-- 우측 데이터 가상화 리스트뷰 -->
            <views:ResultGridView Grid.Column="2" DataContext="{Binding SearchVM}"/>
        </Grid>

        <!-- 4. 상태 표시 바 (StatusBar) -->
        <StatusBar Grid.Row="3" Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                   BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="0,1,0,0" Padding="10,5,10,5"
                   HorizontalContentAlignment="Stretch">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <StatusBarItem Grid.Column="0" HorizontalAlignment="Left">
                <TextBlock Text="{Binding SearchVM.StatusMessage}" FontSize="11" Foreground="DimGray"/>
            </StatusBarItem>

            <StatusBarItem Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,15,0">
                <TextBlock Text="{Binding SearchVM.ResultCountMessage}" FontSize="11" Foreground="DimGray"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
