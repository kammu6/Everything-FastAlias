<Window x:Class="EverythingFastAlias.Views.Modals.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:modern="http://schemas.modernwpf.com/2019"
        Title="Everything FastAlias 도움말 &amp; 문법 가이드" 
        Height="550" Width="650"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
        modern:ThemeManager.RequestedTheme="Light">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Everything FastAlias 도움말" 
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,15"
                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>

        <TabControl Grid.Row="1" VerticalAlignment="Stretch">
            <!-- 탭 1: 기본 검색 문법 -->
            <TabItem Header="기본 검색 문법">
                <ScrollViewer Margin="10" VerticalScrollBarVisibility="Auto">
                    <modern:SimpleStackPanel Spacing="10">
                        <TextBlock Text="기본 연산자" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="• AND (공백) : 단어 사이의 공백은 두 단어를 모두 포함함을 의미합니다. (예: apple banana)" TextWrapping="Wrap"/>
                        <TextBlock Text="• OR (|) : 두 단어 중 하나 이상 포함함을 의미합니다. (예: apple | banana)" TextWrapping="Wrap"/>
                        <TextBlock Text="• NOT (!) : 특정 단어가 포함된 대상을 제외합니다. (예: !tmp)" TextWrapping="Wrap"/>
                        <TextBlock Text="• 그룹화 (&lt; &gt;) : 부등호로 감싸 단어 검색 우선순위를 그룹화합니다. (예: &lt;apple | banana&gt; orange)" TextWrapping="Wrap"/>
                        
                        <Separator Margin="0,10,0,10"/>
                        
                        <TextBlock Text="주요 와일드카드" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="• * : 0개 이상의 모든 문자 매칭 (예: *.txt)" TextWrapping="Wrap"/>
                        <TextBlock Text="• ? : 정확히 1개의 임의의 문자 매칭 (예: memo??.docx)" TextWrapping="Wrap"/>
                    </modern:SimpleStackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 탭 2: 정규식 상용구 -->
            <TabItem Header="정규식 상용구">
                <ScrollViewer Margin="10" VerticalScrollBarVisibility="Auto">
                    <modern:SimpleStackPanel Spacing="10">
                        <TextBlock Text="정규식(Regex) 기본 기호" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="• ^ : 문장의 시작 부분 매칭 (예: ^apple)" TextWrapping="Wrap"/>
                        <TextBlock Text="• $ : 문장의 끝 부분 매칭 (예: banana$)" TextWrapping="Wrap"/>
                        <TextBlock Text="• . : 임의의 한 문자 매칭 (예: a.b)" TextWrapping="Wrap"/>
                        <TextBlock Text="• * : 직전 패턴의 0회 이상 반복 (예: ab*c)" TextWrapping="Wrap"/>
                        <TextBlock Text="• + : 직전 패턴의 1회 이상 반복 (예: ab+c)" TextWrapping="Wrap"/>
                        <TextBlock Text="• [ ] : 문자 집합 중 하나 매칭 (예: [a-z]는 영문 소문자)" TextWrapping="Wrap"/>
                        <TextBlock Text="• d\ : 숫자 매칭 (예: d{4}는 4자리 숫자)" TextWrapping="Wrap"/>
                        
                        <Separator Margin="0,10,0,10"/>
                        <TextBlock Text="※ 주의: 정규식 검색 옵션을 활성화하거나 검색어 앞에 regex: 접두어를 붙이면 정규식 문법이 적용됩니다." 
                                   Foreground="Gray" TextWrapping="Wrap"/>
                    </modern:SimpleStackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 탭 3: FastAlias 사용 팁 -->
            <TabItem Header="FastAlias 팁">
                <ScrollViewer Margin="10" VerticalScrollBarVisibility="Auto">
                    <modern:SimpleStackPanel Spacing="10">
                        <TextBlock Text="스마트 동의어 검색" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="1. [도구] -> [매핑 테이블 관리자]에서 원본 단어와 매핑할 단어들을 지정하세요." TextWrapping="Wrap"/>
                        <TextBlock Text="2. FastAlias 스위치를 켜면 검색어 입력 시 관련어가 자동으로 치환되어 쿼리됩니다." TextWrapping="Wrap"/>
                        <TextBlock Text="   (예: '사과' 입력 시 &lt;사과|apple|🍎&gt; 문법으로 자동 쿼리)" TextWrapping="Wrap"/>
                        
                        <TextBlock Text="FastAlias 다중 키워드 논리 검색 체계" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="FastAlias는 기본 검색 연산자(OR, NOT, 그룹화)와 완벽하게 호환됩니다. 다음과 같이 다중 키워드를 조합할 수 있습니다:" TextWrapping="Wrap"/>
                        <TextBlock Text="• 다중 OR 검색: 키워드 사이에 | (파이프)를 입력하세요. (예: 사과 | 바나나)" TextWrapping="Wrap" Margin="10,0,0,0"/>
                        <TextBlock Text="  (미디어 필터를 적용해도 전체 쿼리에 일관되게 필터가 작동합니다.)" TextWrapping="Wrap" Foreground="Gray" Margin="10,0,0,0"/>
                        <TextBlock Text="• 수동 그룹화 결합: &lt;사과 | 바나나&gt; 와 같이 그룹 기호(&lt; &gt;) 안에서도 동의어 치환이 정상 동작합니다." TextWrapping="Wrap" Margin="10,0,0,0"/>
                        <TextBlock Text="• 제외 조건 결합: !사과 와 같이 느낌표(!)를 붙이면 해당 키워드와 모든 동의어가 검색에서 일괄 제외됩니다." TextWrapping="Wrap" Margin="10,0,0,0"/>
                        
                        <Separator Margin="0,10,0,10"/>
                        
                        <TextBlock Text="단축키 팁" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="• ESC : 검색어 및 필터 조건 모두 초기화" TextWrapping="Wrap"/>
                        <TextBlock Text="• Ctrl + C : 선택한 파일들을 네이티브 파일 객체로 복사 (외부에 붙여넣기 가능)" TextWrapping="Wrap"/>
                        <TextBlock Text="• Ctrl + X : 선택한 파일들을 네이티브 파일 객체로 잘라내기" TextWrapping="Wrap"/>
                        <TextBlock Text="• F1 : 본 도움말 창 호출" TextWrapping="Wrap"/>
                    </modern:SimpleStackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Button Grid.Row="2" Content="닫기" HorizontalAlignment="Right" Width="80" Margin="0,15,0,0"
                Click="CloseButton_Click" Style="{StaticResource AccentButtonStyle}"/>
    </Grid>
</Window>
