<UserControl x:Class="EverythingFastAlias.Views.LeftSidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:modern="http://schemas.modernwpf.com/2019"
             xmlns:models="clr-namespace:EverythingFastAlias.Models"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="320">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <modern:SimpleStackPanel Margin="15" Spacing="20">
            
            <!-- SECTION A: 최상단 조건 초기화 바 -->
            <Button Content="조건 초기화" Command="{Binding ResetCommand}" 
                    HorizontalAlignment="Stretch" Height="40" 
                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                    Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                    FontWeight="SemiBold" BorderThickness="1"/>

            <Separator Margin="0,5,0,5"/>

            <!-- SECTION A-Drive: 검색 대상 드라이브 -->
            <modern:SimpleStackPanel Spacing="8">
                <TextBlock Text="검색 대상 드라이브" FontWeight="SemiBold" FontSize="13" 
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                <ItemsControl ItemsSource="{Binding Drives}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Content="{Binding Name}" 
                                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          Margin="2" Height="28" Width="55" FontSize="11" Padding="4,2,4,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </modern:SimpleStackPanel>

            <!-- SECTION B: 대상 탐색 범위 -->
            <modern:SimpleStackPanel Spacing="8">
                <TextBlock Text="탐색 대상 범위" FontWeight="SemiBold" FontSize="13" 
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <RadioButton Grid.Column="0" Content="전체" IsChecked="{Binding ScopeAll}" Height="32" FontSize="11"/>
                    <RadioButton Grid.Column="1" Content="파일" IsChecked="{Binding ScopeFile}" Height="32" FontSize="11"/>
                    <RadioButton Grid.Column="2" Content="경로" IsChecked="{Binding ScopePath}" Height="32" FontSize="11"/>
                </Grid>
            </modern:SimpleStackPanel>

            <!-- SECTION F: 보기 옵션 -->
            <modern:SimpleStackPanel Spacing="8">
                <TextBlock Text="보기 옵션" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <RadioButton Grid.Column="0" Content="자세히" IsChecked="{Binding ViewModeDetails}" Height="32" FontSize="11"/>
                    <RadioButton Grid.Column="1" Content="섬네일S" IsChecked="{Binding ViewModeThumbnailS}" Height="32" FontSize="11"/>
                    <RadioButton Grid.Column="2" Content="섬네일M" IsChecked="{Binding ViewModeThumbnailM}" Height="32" FontSize="11"/>
                    <RadioButton Grid.Column="3" Content="섬네일L" IsChecked="{Binding ViewModeThumbnailL}" Height="32" FontSize="11"/>
                </Grid>
            </modern:SimpleStackPanel>

            <!-- SECTION C: 프리셋 미디어 필터 -->
            <modern:SimpleStackPanel Spacing="8">
                <TextBlock Text="미디어 필터 (다중 선택)" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                <WrapPanel Margin="0,0,0,5">
                    <ToggleButton Content="전체" IsChecked="{Binding MediaAll}" Margin="1" Height="28" FontSize="11" Padding="4,2,4,2"/>
                    <ToggleButton Content="폴더" IsChecked="{Binding MediaFolder}" Margin="1" Height="28" FontSize="11" Padding="4,2,4,2"/>
                    <ToggleButton Content="영상" IsChecked="{Binding MediaVideo}" Margin="1" Height="28" FontSize="11" Padding="4,2,4,2"/>
                    <ToggleButton Content="음악" IsChecked="{Binding MediaAudio}" Margin="1" Height="28" FontSize="11" Padding="4,2,4,2"/>
                    <ToggleButton Content="사진" IsChecked="{Binding MediaPic}" Margin="1" Height="28" FontSize="11" Padding="4,2,4,2"/>
                    <ToggleButton Content="문서" IsChecked="{Binding MediaDoc}" Margin="1" Height="28" FontSize="11" Padding="4,2,4,2"/>
                    <ToggleButton Content="코드" IsChecked="{Binding MediaCode}" Margin="1" Height="28" FontSize="11" Padding="4,2,4,2"/>
                    <ToggleButton Content="실행" IsChecked="{Binding MediaExe}" Margin="1" Height="28" FontSize="11" Padding="4,2,4,2"/>
                    <ToggleButton Content="압축" IsChecked="{Binding MediaZip}" Margin="1" Height="28" FontSize="11" Padding="4,2,4,2"/>
                </WrapPanel>
                
                <TextBlock Text="커스텀 확장자 필터" FontSize="11" Foreground="Gray"/>
                <TextBox modern:ControlHelper.PlaceholderText="예: zip;7z;rar" Text="{Binding CustomExtensions, UpdateSourceTrigger=PropertyChanged}"/>
            </modern:SimpleStackPanel>

            <!-- SECTION D: 파일 크기 필터 -->
            <modern:SimpleStackPanel Spacing="8">
                <TextBlock Text="파일 크기 필터" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBox Grid.Column="0" modern:ControlHelper.PlaceholderText="최소 크기" Text="{Binding MinSizeText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Column="1" Text="~" VerticalAlignment="Center" Margin="5,0,5,0"/>
                    <TextBox Grid.Column="2" modern:ControlHelper.PlaceholderText="최대 크기" Text="{Binding MaxSizeText, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
                
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <RadioButton Grid.Column="0" Content="KB" IsChecked="{Binding SizeKB}" Height="28" FontSize="11"/>
                    <RadioButton Grid.Column="1" Content="MB" IsChecked="{Binding SizeMB}" Height="28" FontSize="11"/>
                    <RadioButton Grid.Column="2" Content="GB" IsChecked="{Binding SizeGB}" Height="28" FontSize="11"/>
                    <Button Grid.Column="3" Content="크기 초기화" Click="ResetSize_Click" Margin="5,0,0,0" Height="28" FontSize="11" Padding="4,2,4,2"/>
                </Grid>
            </modern:SimpleStackPanel>

            <Separator Margin="0,5,0,5"/>

            <!-- SECTION E: 토글 옵션 그룹 (Grid 2x2 - 검색 엔진 옵션) -->
            <modern:SimpleStackPanel Spacing="8">
                <TextBlock Text="검색 엔진 옵션" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                <UniformGrid Columns="2" Rows="2">
                    <CheckBox Content="대소문자 구분" IsChecked="{Binding Options.MatchCase}" Margin="2,2,2,2" FontSize="11"/>
                    <CheckBox Content="전체 단어 일치" IsChecked="{Binding Options.MatchWholeWord}" Margin="2,2,2,2" FontSize="11"/>
                    <CheckBox Content="정규식 검색" IsChecked="{Binding Options.UseRegex}" Margin="2,2,2,2" FontSize="11"/>
                    <CheckBox Content="휴지통 포함" IsChecked="{Binding Options.IncludeRecycleBin}" Margin="2,2,2,2" FontSize="11"/>
                </UniformGrid>
            </modern:SimpleStackPanel>
            
        </modern:SimpleStackPanel>
    </ScrollViewer>
</UserControl>
